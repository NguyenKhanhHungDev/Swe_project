title Kiểm tra và xác nhận Checkout

actor Frontend
participant "CheckoutController" as Ctrl
participant "CheckoutService" as CSvc
participant "CartService (Huy)" as CartSvc
participant "PromotionsService" as PromoSvc

Frontend -> Ctrl : POST /checkout/preview (cartItems, promotionCode)
activate Ctrl

Ctrl -> CSvc : previewCheckout(cartItems, promotionCode)
activate CSvc

CSvc -> CartSvc : validateItems(cartItems)
activate CartSvc
CartSvc --> CSvc : validItems + subtotal
deactivate CartSvc

opt Có promotionCode
    CSvc -> PromoSvc : validateAndCalculateDiscount(promotionCode, subtotal)
    activate PromoSvc
    PromoSvc --> CSvc : discount amount
    deactivate PromoSvc
end

CSvc -> CSvc : calculate total (subtotal - discount)
CSvc --> Ctrl : { subtotal, discount, total }
deactivate CSvc

Ctrl --> Frontend : 200 OK { data: { ... } }
deactivate Ctrl
@enduml
